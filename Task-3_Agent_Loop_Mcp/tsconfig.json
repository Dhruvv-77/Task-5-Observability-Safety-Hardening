{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "packages/agent/src/**/*.ts",
        "evals/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "corpus"
    ]
}